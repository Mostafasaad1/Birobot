<?xml version="1.0" encoding="UTF-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for data used mostly by MoveIt-->
<robot name="birobot">
    <!--GROUPS: Representation of a set of joints and links.-->
    <!--Group arm_1: Kinematic chain for Left Arm-->
    <group name="arm_1">
        <chain base_link="arm1_base_link" tip_link="arm1_tool0"/>
    </group>

    <!--Group arm_2: Kinematic chain for Right Arm-->
    <group name="arm_2">
        <chain base_link="arm2_base_link" tip_link="arm2_tool0"/>
    </group>

    <!--Group dual_arms: Subgroup composition of arm_1 and arm_2-->
    <group name="dual_arms">
        <group name="arm_1"/>
        <group name="arm_2"/>
    </group>

    <!--Group arm1_hand: Gripper group for Left Arm-->
    <group name="arm1_hand">
        <link name="arm1_gripper_base_link"/>
        <link name="arm1_gripper_left_finger"/>
        <link name="arm1_gripper_right_finger"/>
        <link name="arm1_gripper_tcp"/>
        <joint name="arm1_gripper_left_finger_joint"/>
        <joint name="arm1_gripper_right_finger_joint"/>
    </group>

    <!--Group arm2_hand: Gripper group for Right Arm-->
    <group name="arm2_hand">
        <link name="arm2_gripper_base_link"/>
        <link name="arm2_gripper_left_finger"/>
        <link name="arm2_gripper_right_finger"/>
        <link name="arm2_gripper_tcp"/>
        <joint name="arm2_gripper_left_finger_joint"/>
        <joint name="arm2_gripper_right_finger_joint"/>
    </group>

    <!--GROUP STATES: Default named joint poses-->
    <group_state name="home" group="arm_1">
        <joint name="arm1_elbow_joint" value="0"/>
        <joint name="arm1_shoulder_lift_joint" value="-1.5708"/>
        <joint name="arm1_shoulder_pan_joint" value="0"/>
        <joint name="arm1_wrist_1_joint" value="-1.5708"/>
        <joint name="arm1_wrist_2_joint" value="0"/>
        <joint name="arm1_wrist_3_joint" value="0"/>
    </group_state>
    <group_state name="handover" group="arm_1">
        <joint name="arm1_shoulder_pan_joint" value="0.0"/>
        <joint name="arm1_shoulder_lift_joint" value="-1.0472"/>
        <joint name="arm1_elbow_joint" value="1.3963"/>
        <joint name="arm1_wrist_1_joint" value="-1.9198"/>
        <joint name="arm1_wrist_2_joint" value="-1.5708"/>
        <joint name="arm1_wrist_3_joint" value="0.0"/>
    </group_state>
    <group_state name="home" group="arm_2">
        <joint name="arm2_elbow_joint" value="0"/>
        <joint name="arm2_shoulder_lift_joint" value="-1.5708"/>
        <joint name="arm2_shoulder_pan_joint" value="0"/>
        <joint name="arm2_wrist_1_joint" value="-1.5708"/>
        <joint name="arm2_wrist_2_joint" value="0"/>
        <joint name="arm2_wrist_3_joint" value="0"/>
    </group_state>
    <group_state name="handover" group="arm_2">
        <joint name="arm2_shoulder_pan_joint" value="0.0"/>
        <joint name="arm2_shoulder_lift_joint" value="-1.0472"/>
        <joint name="arm2_elbow_joint" value="1.3963"/>
        <joint name="arm2_wrist_1_joint" value="-1.9198"/>
        <joint name="arm2_wrist_2_joint" value="-1.5708"/>
        <joint name="arm2_wrist_3_joint" value="0.0"/>
    </group_state>
    <group_state name="drop_off" group="arm_2">
        <joint name="arm2_shoulder_pan_joint" value="-0.7854"/>
        <joint name="arm2_shoulder_lift_joint" value="-1.2217"/>
        <joint name="arm2_elbow_joint" value="1.5708"/>
        <joint name="arm2_wrist_1_joint" value="-1.9198"/>
        <joint name="arm2_wrist_2_joint" value="-1.5708"/>
        <joint name="arm2_wrist_3_joint" value="0.0"/>
    </group_state>
    <group_state name="home" group="dual_arms">
        <joint name="arm1_elbow_joint" value="0"/>
        <joint name="arm1_shoulder_lift_joint" value="-1.5708"/>
        <joint name="arm1_shoulder_pan_joint" value="0"/>
        <joint name="arm1_wrist_1_joint" value="-1.5708"/>
        <joint name="arm1_wrist_2_joint" value="0"/>
        <joint name="arm1_wrist_3_joint" value="0"/>
        <joint name="arm2_elbow_joint" value="0"/>
        <joint name="arm2_shoulder_lift_joint" value="-1.5708"/>
        <joint name="arm2_shoulder_pan_joint" value="0"/>
        <joint name="arm2_wrist_1_joint" value="-1.5708"/>
        <joint name="arm2_wrist_2_joint" value="0"/>
        <joint name="arm2_wrist_3_joint" value="0"/>
    </group_state>
    <group_state name="handover" group="dual_arms">
        <joint name="arm1_shoulder_pan_joint" value="0.0"/>
        <joint name="arm1_shoulder_lift_joint" value="-1.0472"/>
        <joint name="arm1_elbow_joint" value="1.3963"/>
        <joint name="arm1_wrist_1_joint" value="-1.9198"/>
        <joint name="arm1_wrist_2_joint" value="-1.5708"/>
        <joint name="arm1_wrist_3_joint" value="0.0"/>
        <joint name="arm2_shoulder_pan_joint" value="0.0"/>
        <joint name="arm2_shoulder_lift_joint" value="-1.0472"/>
        <joint name="arm2_elbow_joint" value="1.3963"/>
        <joint name="arm2_wrist_1_joint" value="-1.9198"/>
        <joint name="arm2_wrist_2_joint" value="-1.5708"/>
        <joint name="arm2_wrist_3_joint" value="0.0"/>
    </group_state>
    <group_state name="open" group="arm1_hand">
        <joint name="arm1_gripper_left_finger_joint" value="0.04"/>
        <joint name="arm1_gripper_right_finger_joint" value="0.04"/>
    </group_state>
    <group_state name="closed" group="arm1_hand">
        <joint name="arm1_gripper_left_finger_joint" value="0"/>
        <joint name="arm1_gripper_right_finger_joint" value="0"/>
    </group_state>
    <group_state name="open" group="arm2_hand">
        <joint name="arm2_gripper_left_finger_joint" value="0.04"/>
        <joint name="arm2_gripper_right_finger_joint" value="0.04"/>
    </group_state>
    <group_state name="closed" group="arm2_hand">
        <joint name="arm2_gripper_left_finger_joint" value="0"/>
        <joint name="arm2_gripper_right_finger_joint" value="0"/>
    </group_state>

    <!--END EFFECTOR: Purpose: Represent information about an end effector.-->
    <end_effector name="arm1_ee" parent_link="arm1_tool0" group="arm_1"/>
    <end_effector name="arm2_ee" parent_link="arm2_tool0" group="arm_2"/>
    <end_effector name="arm1_gripper" parent_link="arm1_tool0" group="arm1_hand"/>
    <end_effector name="arm2_gripper" parent_link="arm2_tool0" group="arm2_hand"/>

    <!--VIRTUAL JOINT: Purpose: this element defines a virtual joint between a robot link and an external frame of reference (written trace because it has no child link)-->
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="workcell_base_link"/>

    <!--DISABLE COLLISIONS: By default it is assumed that any two links of the robot could potentially come into collision. The tags below disable collision checking between specified pairs of links. -->
    <!-- Workcell Base to Arm Bases and Shoulders -->
    <disable_collisions link1="workcell_base_link" link2="arm1_base_link" reason="Adjacent"/>
    <disable_collisions link1="workcell_base_link" link2="arm1_base_link_inertia" reason="Default"/>
    <disable_collisions link1="workcell_base_link" link2="arm1_shoulder_link" reason="Never"/>
    <disable_collisions link1="workcell_base_link" link2="arm1_upper_arm_link" reason="Never"/>
    <disable_collisions link1="workcell_base_link" link2="arm1_forearm_link" reason="Never"/>
    <disable_collisions link1="workcell_base_link" link2="arm2_base_link" reason="Adjacent"/>
    <disable_collisions link1="workcell_base_link" link2="arm2_base_link_inertia" reason="Default"/>
    <disable_collisions link1="workcell_base_link" link2="arm2_shoulder_link" reason="Never"/>
    <disable_collisions link1="workcell_base_link" link2="arm2_upper_arm_link" reason="Never"/>
    <disable_collisions link1="workcell_base_link" link2="arm2_forearm_link" reason="Never"/>

    <!-- Arm 1 Internal Link Pairs (Adjacent & Default/Never) -->
    <disable_collisions link1="arm1_base_link" link2="arm1_base_link_inertia" reason="Adjacent"/>
    <disable_collisions link1="arm1_base_link" link2="arm1_shoulder_link" reason="Never"/>
    <disable_collisions link1="arm1_base_link_inertia" link2="arm1_shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="arm1_shoulder_link" link2="arm1_upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="arm1_upper_arm_link" link2="arm1_forearm_link" reason="Adjacent"/>
    <disable_collisions link1="arm1_forearm_link" link2="arm1_wrist_1_link" reason="Adjacent"/>
    <disable_collisions link1="arm1_wrist_1_link" link2="arm1_wrist_2_link" reason="Adjacent"/>
    <disable_collisions link1="arm1_wrist_2_link" link2="arm1_wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="arm1_wrist_3_link" link2="arm1_flange" reason="Adjacent"/>
    <disable_collisions link1="arm1_wrist_3_link" link2="arm1_tool0" reason="Adjacent"/>
    <disable_collisions link1="arm1_flange" link2="arm1_tool0" reason="Adjacent"/>
    <disable_collisions link1="arm1_wrist_1_link" link2="arm1_wrist_3_link" reason="Never"/>
    <disable_collisions link1="arm1_wrist_1_link" link2="arm1_flange" reason="Never"/>
    <disable_collisions link1="arm1_wrist_1_link" link2="arm1_tool0" reason="Never"/>

    <!-- Arm 1 Gripper Collisions -->
    <disable_collisions link1="arm1_forearm_link" link2="arm1_wrist_2_link" reason="Never"/>
    <disable_collisions link1="arm1_forearm_link" link2="arm1_wrist_3_link" reason="Never"/>
    <disable_collisions link1="arm1_forearm_link" link2="arm1_flange" reason="Never"/>
    <disable_collisions link1="arm1_forearm_link" link2="arm1_tool0" reason="Never"/>
    <disable_collisions link1="arm1_forearm_link" link2="arm1_gripper_base_link" reason="Never"/>
    <disable_collisions link1="arm1_forearm_link" link2="arm1_gripper_left_finger" reason="Never"/>
    <disable_collisions link1="arm1_forearm_link" link2="arm1_gripper_right_finger" reason="Never"/>
    <disable_collisions link1="arm1_wrist_1_link" link2="arm1_gripper_base_link" reason="Never"/>
    <disable_collisions link1="arm1_wrist_1_link" link2="arm1_gripper_left_finger" reason="Never"/>
    <disable_collisions link1="arm1_wrist_1_link" link2="arm1_gripper_right_finger" reason="Never"/>
    <disable_collisions link1="arm1_wrist_2_link" link2="arm1_gripper_base_link" reason="Never"/>
    <disable_collisions link1="arm1_wrist_2_link" link2="arm1_gripper_left_finger" reason="Never"/>
    <disable_collisions link1="arm1_wrist_2_link" link2="arm1_gripper_right_finger" reason="Never"/>
    <disable_collisions link1="arm1_wrist_3_link" link2="arm1_gripper_left_finger" reason="Never"/>
    <disable_collisions link1="arm1_wrist_3_link" link2="arm1_gripper_right_finger" reason="Never"/>
    <disable_collisions link1="arm1_tool0" link2="arm1_gripper_base_link" reason="Adjacent"/>
    <disable_collisions link1="arm1_tool0" link2="arm1_gripper_left_finger" reason="Never"/>
    <disable_collisions link1="arm1_tool0" link2="arm1_gripper_right_finger" reason="Never"/>
    <disable_collisions link1="arm1_flange" link2="arm1_gripper_base_link" reason="Never"/>
    <disable_collisions link1="arm1_flange" link2="arm1_gripper_left_finger" reason="Never"/>
    <disable_collisions link1="arm1_flange" link2="arm1_gripper_right_finger" reason="Never"/>
    <disable_collisions link1="arm1_wrist_3_link" link2="arm1_gripper_base_link" reason="Never"/>
    <disable_collisions link1="arm1_gripper_base_link" link2="arm1_gripper_left_finger" reason="Adjacent"/>
    <disable_collisions link1="arm1_gripper_base_link" link2="arm1_gripper_right_finger" reason="Adjacent"/>
    <disable_collisions link1="arm1_gripper_left_finger" link2="arm1_gripper_right_finger" reason="Default"/>

    <!-- Arm 2 Internal Link Pairs (Adjacent & Default/Never) -->
    <disable_collisions link1="arm2_base_link" link2="arm2_base_link_inertia" reason="Adjacent"/>
    <disable_collisions link1="arm2_base_link" link2="arm2_shoulder_link" reason="Never"/>
    <disable_collisions link1="arm2_base_link_inertia" link2="arm2_shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="arm2_shoulder_link" link2="arm2_upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="arm2_upper_arm_link" link2="arm2_forearm_link" reason="Adjacent"/>
    <disable_collisions link1="arm2_forearm_link" link2="arm2_wrist_1_link" reason="Adjacent"/>
    <disable_collisions link1="arm2_forearm_link" link2="arm2_wrist_2_link" reason="Never"/>
    <disable_collisions link1="arm2_wrist_1_link" link2="arm2_wrist_2_link" reason="Adjacent"/>
    <disable_collisions link1="arm2_wrist_2_link" link2="arm2_wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="arm2_wrist_3_link" link2="arm2_flange" reason="Adjacent"/>
    <disable_collisions link1="arm2_wrist_3_link" link2="arm2_tool0" reason="Adjacent"/>
    <disable_collisions link1="arm2_flange" link2="arm2_tool0" reason="Adjacent"/>
    <disable_collisions link1="arm2_wrist_1_link" link2="arm2_wrist_3_link" reason="Never"/>
    <disable_collisions link1="arm2_wrist_1_link" link2="arm2_flange" reason="Never"/>
    <disable_collisions link1="arm2_wrist_1_link" link2="arm2_tool0" reason="Never"/>

    <!-- Arm 2 Gripper Collisions -->
    <disable_collisions link1="arm2_forearm_link" link2="arm2_wrist_2_link" reason="Never"/>
    <disable_collisions link1="arm2_forearm_link" link2="arm2_wrist_3_link" reason="Never"/>
    <disable_collisions link1="arm2_forearm_link" link2="arm2_flange" reason="Never"/>
    <disable_collisions link1="arm2_forearm_link" link2="arm2_tool0" reason="Never"/>
    <disable_collisions link1="arm2_forearm_link" link2="arm2_gripper_base_link" reason="Never"/>
    <disable_collisions link1="arm2_forearm_link" link2="arm2_gripper_left_finger" reason="Never"/>
    <disable_collisions link1="arm2_forearm_link" link2="arm2_gripper_right_finger" reason="Never"/>
    <disable_collisions link1="arm2_wrist_1_link" link2="arm2_gripper_base_link" reason="Never"/>
    <disable_collisions link1="arm2_wrist_1_link" link2="arm2_gripper_left_finger" reason="Never"/>
    <disable_collisions link1="arm2_wrist_1_link" link2="arm2_gripper_right_finger" reason="Never"/>
    <disable_collisions link1="arm2_wrist_2_link" link2="arm2_gripper_base_link" reason="Never"/>
    <disable_collisions link1="arm2_wrist_2_link" link2="arm2_gripper_left_finger" reason="Never"/>
    <disable_collisions link1="arm2_wrist_2_link" link2="arm2_gripper_right_finger" reason="Never"/>
    <disable_collisions link1="arm2_wrist_3_link" link2="arm2_gripper_left_finger" reason="Never"/>
    <disable_collisions link1="arm2_wrist_3_link" link2="arm2_gripper_right_finger" reason="Never"/>
    <disable_collisions link1="arm2_tool0" link2="arm2_gripper_base_link" reason="Adjacent"/>
    <disable_collisions link1="arm2_tool0" link2="arm2_gripper_left_finger" reason="Never"/>
    <disable_collisions link1="arm2_tool0" link2="arm2_gripper_right_finger" reason="Never"/>
    <disable_collisions link1="arm2_flange" link2="arm2_gripper_base_link" reason="Never"/>
    <disable_collisions link1="arm2_flange" link2="arm2_gripper_left_finger" reason="Never"/>
    <disable_collisions link1="arm2_flange" link2="arm2_gripper_right_finger" reason="Never"/>
    <disable_collisions link1="arm2_wrist_3_link" link2="arm2_gripper_base_link" reason="Never"/>
    <disable_collisions link1="arm2_gripper_base_link" link2="arm2_gripper_left_finger" reason="Adjacent"/>
    <disable_collisions link1="arm2_gripper_base_link" link2="arm2_gripper_right_finger" reason="Adjacent"/>
    <disable_collisions link1="arm2_gripper_left_finger" link2="arm2_gripper_right_finger" reason="Default"/>

    <!-- Inter-Arm Link Pairs (Arm1 vs Arm2) -->
    <disable_collisions link1="arm1_base_link" link2="arm2_base_link" reason="Never"/>
    <disable_collisions link1="arm1_base_link" link2="arm2_base_link_inertia" reason="Never"/>
    <disable_collisions link1="arm1_base_link" link2="arm2_shoulder_link" reason="Never"/>
    <disable_collisions link1="arm1_base_link" link2="arm2_upper_arm_link" reason="Never"/>
    <disable_collisions link1="arm1_base_link" link2="arm2_forearm_link" reason="Never"/>
    <disable_collisions link1="arm1_base_link" link2="arm2_wrist_1_link" reason="Never"/>
    <disable_collisions link1="arm1_base_link" link2="arm2_wrist_2_link" reason="Never"/>
    <disable_collisions link1="arm1_base_link" link2="arm2_wrist_3_link" reason="Never"/>
    <disable_collisions link1="arm1_base_link" link2="arm2_gripper_base_link" reason="Never"/>

    <disable_collisions link1="arm1_shoulder_link" link2="arm2_base_link" reason="Never"/>
    <disable_collisions link1="arm1_shoulder_link" link2="arm2_base_link_inertia" reason="Never"/>
    <disable_collisions link1="arm1_shoulder_link" link2="arm2_shoulder_link" reason="Never"/>
    <disable_collisions link1="arm1_shoulder_link" link2="arm2_upper_arm_link" reason="Never"/>
    <disable_collisions link1="arm1_shoulder_link" link2="arm2_forearm_link" reason="Never"/>
    <disable_collisions link1="arm1_shoulder_link" link2="arm2_wrist_1_link" reason="Never"/>
    <disable_collisions link1="arm1_shoulder_link" link2="arm2_wrist_2_link" reason="Never"/>
    <disable_collisions link1="arm1_shoulder_link" link2="arm2_wrist_3_link" reason="Never"/>

    <disable_collisions link1="arm1_upper_arm_link" link2="arm2_base_link" reason="Never"/>
    <disable_collisions link1="arm1_upper_arm_link" link2="arm2_base_link_inertia" reason="Never"/>
    <disable_collisions link1="arm1_upper_arm_link" link2="arm2_shoulder_link" reason="Never"/>
    <disable_collisions link1="arm1_upper_arm_link" link2="arm2_upper_arm_link" reason="Never"/>
    <disable_collisions link1="arm1_upper_arm_link" link2="arm2_forearm_link" reason="Never"/>
    <disable_collisions link1="arm1_upper_arm_link" link2="arm2_wrist_1_link" reason="Never"/>
    <disable_collisions link1="arm1_upper_arm_link" link2="arm2_wrist_2_link" reason="Never"/>
    <disable_collisions link1="arm1_upper_arm_link" link2="arm2_wrist_3_link" reason="Never"/>

    <disable_collisions link1="arm1_forearm_link" link2="arm2_base_link" reason="Never"/>
    <disable_collisions link1="arm1_forearm_link" link2="arm2_base_link_inertia" reason="Never"/>
    <disable_collisions link1="arm1_forearm_link" link2="arm2_shoulder_link" reason="Never"/>
    <disable_collisions link1="arm1_forearm_link" link2="arm2_upper_arm_link" reason="Never"/>
    <disable_collisions link1="arm1_forearm_link" link2="arm2_forearm_link" reason="Never"/>
    <disable_collisions link1="arm1_forearm_link" link2="arm2_wrist_1_link" reason="Never"/>
    <disable_collisions link1="arm1_forearm_link" link2="arm2_wrist_2_link" reason="Never"/>
    <disable_collisions link1="arm1_forearm_link" link2="arm2_wrist_3_link" reason="Never"/>

    <disable_collisions link1="arm1_wrist_1_link" link2="arm2_base_link" reason="Never"/>
    <disable_collisions link1="arm1_wrist_1_link" link2="arm2_base_link_inertia" reason="Never"/>
    <disable_collisions link1="arm1_wrist_1_link" link2="arm2_shoulder_link" reason="Never"/>
    <disable_collisions link1="arm1_wrist_1_link" link2="arm2_upper_arm_link" reason="Never"/>
    <disable_collisions link1="arm1_wrist_1_link" link2="arm2_forearm_link" reason="Never"/>
    <disable_collisions link1="arm1_wrist_1_link" link2="arm2_wrist_1_link" reason="Never"/>
    <disable_collisions link1="arm1_wrist_1_link" link2="arm2_wrist_2_link" reason="Never"/>
    <disable_collisions link1="arm1_wrist_1_link" link2="arm2_wrist_3_link" reason="Never"/>

    <disable_collisions link1="arm1_wrist_2_link" link2="arm2_base_link" reason="Never"/>
    <disable_collisions link1="arm1_wrist_2_link" link2="arm2_base_link_inertia" reason="Never"/>
    <disable_collisions link1="arm1_wrist_2_link" link2="arm2_shoulder_link" reason="Never"/>
    <disable_collisions link1="arm1_wrist_2_link" link2="arm2_upper_arm_link" reason="Never"/>
    <disable_collisions link1="arm1_wrist_2_link" link2="arm2_forearm_link" reason="Never"/>
    <disable_collisions link1="arm1_wrist_2_link" link2="arm2_wrist_1_link" reason="Never"/>
    <disable_collisions link1="arm1_wrist_2_link" link2="arm2_wrist_2_link" reason="Never"/>
    <disable_collisions link1="arm1_wrist_2_link" link2="arm2_wrist_3_link" reason="Never"/>

    <disable_collisions link1="arm1_wrist_3_link" link2="arm2_base_link" reason="Never"/>
    <disable_collisions link1="arm1_wrist_3_link" link2="arm2_base_link_inertia" reason="Never"/>
    <disable_collisions link1="arm1_wrist_3_link" link2="arm2_shoulder_link" reason="Never"/>
    <disable_collisions link1="arm1_wrist_3_link" link2="arm2_upper_arm_link" reason="Never"/>
    <disable_collisions link1="arm1_wrist_3_link" link2="arm2_forearm_link" reason="Never"/>
    <disable_collisions link1="arm1_wrist_3_link" link2="arm2_wrist_1_link" reason="Never"/>
    <disable_collisions link1="arm1_wrist_3_link" link2="arm2_wrist_2_link" reason="Never"/>
    <disable_collisions link1="arm1_wrist_3_link" link2="arm2_wrist_3_link" reason="Never"/>

    <disable_collisions link1="arm1_gripper_base_link" link2="arm2_base_link" reason="Never"/>
    <disable_collisions link1="arm1_gripper_base_link" link2="arm2_shoulder_link" reason="Never"/>
    <disable_collisions link1="arm1_gripper_base_link" link2="arm2_upper_arm_link" reason="Never"/>
    <disable_collisions link1="arm1_gripper_base_link" link2="arm2_forearm_link" reason="Never"/>
    <disable_collisions link1="arm1_gripper_base_link" link2="arm2_wrist_1_link" reason="Never"/>
