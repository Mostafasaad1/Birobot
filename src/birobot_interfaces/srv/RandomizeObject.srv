# ============================================================
# RandomizeObject.srv
# Service to reposition or randomize irregular_object_1
# ============================================================

# Request
string zone            # "other_side" (past table), "front" (on table), "all", or "custom"
bool custom_pose       # if true, use explicit custom_x, custom_y, custom_z, custom_yaw
float64 custom_x
float64 custom_y
float64 custom_z
float64 custom_yaw
---
# Response
bool success
string message
float64 x
float64 y
float64 z
float64 yaw
string location_desc   # "GROUND (PAST TABLE BORDER)" or "ON TABLE"
