<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <!--
    Macro: two_finger_gripper
    Parametric 2-finger parallel gripper with prismatic finger joints and TCP frame.
  -->
  <xacro:macro name="two_finger_gripper" params="name prefix parent *origin">

    <!-- Gripper Base Link -->
    <link name="${prefix}base_link">
      <visual>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <geometry>
          <box size="0.08 0.08 0.08"/>
        </geometry>
        <material name="${prefix}base_material">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <geometry>
          <box size="0.08 0.08 0.08"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.0005"/>
      </inertial>
    </link>

    <!-- Mount joint: parent link to gripper base -->
    <joint name="${prefix}base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- Left Finger Link -->
    <link name="${prefix}left_finger">
      <visual>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <geometry>
          <box size="0.015 0.03 0.06"/>
        </geometry>
        <material name="${prefix}finger_material">
          <color rgba="0.8 0.8 0.8 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <geometry>
          <box size="0.015 0.03 0.06"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
      </inertial>
    </link>

    <!-- Left Finger Prismatic Joint -->
    <joint name="${prefix}left_finger_joint" type="prismatic">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}left_finger"/>
      <origin xyz="0.025 0 0.08" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0.0" upper="0.04" effort="50.0" velocity="0.15"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <!-- Right Finger Link -->
    <link name="${prefix}right_finger">
      <visual>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <geometry>
          <box size="0.015 0.03 0.06"/>
        </geometry>
        <material name="${prefix}finger_material"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <geometry>
          <box size="0.015 0.03 0.06"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
      </inertial>
    </link>

    <!-- Right Finger Prismatic Joint -->
    <joint name="${prefix}right_finger_joint" type="prismatic">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}right_finger"/>
      <origin xyz="-0.025 0 0.08" rpy="0 0 0"/>
      <axis xyz="-1 0 0"/>
      <limit lower="0.0" upper="0.04" effort="50.0" velocity="0.15"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <!-- Tool Center Point (TCP) link & joint -->
    <link name="${prefix}tcp"/>
    <joint name="${prefix}tcp_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}tcp"/>
      <origin xyz="0 0 0.130" rpy="0 0 0"/>
    </joint>

    <!-- Gazebo Sim ros2_control interface tags for gripper joints -->
    <ros2_control name="${name}_ros2_control" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <joint name="${prefix}left_finger_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}right_finger_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

  </xacro:macro>

</robot>
