<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="depth_camera" params="name parent *origin">
    
    <!-- Camera mount joint -->
    <joint name="${name}_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${name}_link"/>
    </joint>

    <!-- Camera physical link -->
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.15 0.05"/>
        </geometry>
        <material name="${name}_material">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.15 0.05"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0004" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0004"/>
      </inertial>
    </link>

    <!-- Optical frame joint (ROS optical frame standard: Z forward, X right, Y down) -->
    <joint name="${name}_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
      <parent link="${name}_link"/>
      <child link="${name}_optical_frame"/>
    </joint>

    <link name="${name}_optical_frame"/>

    <!-- Gazebo sensor definition for RGB Camera (color feed) -->
    <gazebo reference="${name}_link">
      <sensor type="camera" name="${name}_rgb_sensor">
        <gz_frame_id>${name}_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>15.0</update_rate>
        <topic>/birobot/depth_camera/image</topic>
        <camera name="${name}_rgb">
          <horizontal_fov>1.2</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>5.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>

    <!-- Gazebo sensor definition for Depth & PointCloud (gz-sim) -->
    <gazebo reference="${name}_link">
      <sensor type="depth" name="${name}_sensor">
        <gz_frame_id>${name}_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>15.0</update_rate>
        <topic>/birobot/depth_camera/points</topic>
        <camera name="${name}">
          <horizontal_fov>1.2</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>5.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.003</stddev>
          </noise>
        </camera>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>
